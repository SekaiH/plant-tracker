# 資料庫連線
# 開發／交接測試預設用 SQLite，正式環境建議改用 PostgreSQL（見 README「正式環境部署」章節）
DATABASE_URL="file:./dev.db"

# 伺服器
PORT=4000

# JWT 認證
JWT_SECRET="please-change-this-secret-in-production"
JWT_EXPIRES_IN="7d"

# 單一使用者初始帳號（供 prisma/seed.js 建立管理者帳號用）
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="changeme123"

# 上傳檔案儲存路徑（本地開發用；正式環境建議改接 S3／Cloudflare R2，見 README）
UPLOAD_DIR="./uploads"
